dist/
frontend/dist/
dist-ssr/
*.local

# Environment variables & local credentials
.env
.env.local
.env.*.local
!.env.example
backend/.env
frontend/.env

# Logs and runtime artifacts
*.log
logs/

# IDE & Editor files
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
